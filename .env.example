MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/dentists
MONGODB_DB=dentists
# Set these for a clinic provisioned by the separate super admin app.
MANAGED_CLINIC=false
MANAGED_CLINIC_SLUG=
CLINIC_CONTROL_SECRET=
# Public self-registration is off unless deliberately enabled for a legacy installation.
ALLOW_PUBLIC_CLINIC_REGISTRATION=false
REMINDER_CRON_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-the-same-long-random-secret-for-vercel-cron
RESEND_API_KEY=
EMAIL_FROM=
CLINIC_SMTP_SECRET=replace-with-a-unique-random-string-at-least-32-characters

# Server-only AI provider key (never use NEXT_PUBLIC_).
GROQ_API_KEY=

# Evolution API WhatsApp Server
EVOLUTION_API_URL=https://your-whatsapp-provider.example
EVOLUTION_API_KEY=
EVOLUTION_DEFAULT_INSTANCE=clinic-main
